NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LIVE_PROVIDER=tikfinity
TIKFINITY_WS_URL=ws://127.0.0.1:21213/

# EulerStream: ket noi thang toi TikTok, khong can TikFinity Desktop.
# Co the dan key ngay trong Control Panel, dat o day de khoi nhap lai moi lan.
# Lay key tai https://www.eulerstream.com
EULER_API_KEY=

# Keep disabled unless you intentionally expose the bridge to a trusted LAN.
ALLOW_LAN=0
