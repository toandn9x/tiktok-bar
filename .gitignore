# ═══════════════════════════════════════════════
#  .gitignore — Toandn Live
#  Node.js + Unity + Media
# ═══════════════════════════════════════════════

# ── BÍ MẬT — tuyệt đối không đưa lên git ─────
# Repo này công khai. Mọi thứ dưới đây chứa hoặc có thể chứa
# API key, mật khẩu, chứng chỉ, dữ liệu người xem.
.env
.env.*
!.env.example
*.env
secrets.json
credentials.json
*credential*.json
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
*.crt
apikey.txt
api_key.txt
token.txt

# ── Node.js ──────────────────────────────────
node_modules/
npm-debug.log*

# ── Unity (Library, cache, build) ────────────
UnityProject/Library/
UnityProject/Temp/
UnityProject/Logs/
UnityProject/UserSettings/
UnityProject/MemoryCaptures/
UnityProject/obj/
UnityProject/Build/
UnityProject/Builds/
UnityProject/CommercialBuild/
UnityProject/Assets/AssetStoreTools/

# ── Compiled Build output ────────────────────
Build/

# ── Build logs ───────────────────────────────
build_log.txt

# ── Log & lịch sử phiên của bridge (sinh ra lúc chạy) ──
# Log có thể chứa username, và lịch sử phiên chứa tên người xem
# cùng số tiền họ tặng — dữ liệu cá nhân, không nên công khai.
TikTokBridge/logs/
TikTokBridge/data/
*.log

# ── Media lớn (người dùng tự thêm) ──────────
DJ_MUSIC/*.mp3
DJ_MUSIC/*.MP3
DJ_MUSIC/*.wav
DJ_MUSIC/*.WAV
DJ_MUSIC/*.ogg
DJ_MUSIC/*.OGG
DJ_MUSIC/*.flac

DJ_VIDEO/*.mp4
DJ_VIDEO/*.MP4
DJ_VIDEO/*.mov
DJ_VIDEO/*.MOV
DJ_VIDEO/*.m4v
DJ_VIDEO/*.webm
DJ_VIDEO/*.mp4.bak

# ── OS & IDE ─────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.csproj.user
*.unityproj
*.sln
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ── Visual Studio / Rider / VSCode ───────────
.vs/
.vscode/
.idea/
*.userprefs

# ── Crash reports ────────────────────────────
sysinfo.txt
crashlytics-build.properties
